+async def idle_keepalive_tick(components: Components) -> None:
+    runtime = components.readiness.runtime
+    if not getattr(runtime, "idle_keepalive_enabled", False):
+        return
+    lease = components.gate.try_acquire()
+    if lease is None:
+        return  # A real request always takes priority; never queue behind it.
+    try:
+        await components.gpu.run(runtime.idle_tick)
+    finally:
+        lease.release()
+
+
+async def keep_runtime_ready(components: Components) -> None:
+    try:
+        while True:
+            await asyncio.sleep(1)
+            await idle_keepalive_tick(components)
+    except asyncio.CancelledError:
+        raise
+    except Exception as exc:
+        components.events.emit("model.keepalive_failed", level="warning", error=repr(exc))
+
+
