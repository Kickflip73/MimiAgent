diff --git a/tests/test_idle_keepalive.py b/tests/test_idle_keepalive.py
new file mode 100644
--- /dev/null
+++ b/tests/test_idle_keepalive.py
@@ -0,0 +1,42 @@
+import asyncio
+from types import SimpleNamespace
+from breeze_infer.api import idle_keepalive_tick
+from breeze_infer.gpu import GpuGate, GpuThread
+from breeze_infer.routes_health import Readiness
+
+
+def test_keepalive_is_idle_only_opt_in_and_releases_the_gate():
+    async def scenario():
+        calls = []
+        gpu = GpuThread('cpu', set_device=lambda _: None)
+        gate = GpuGate()
+        ready = Readiness()
+        components = SimpleNamespace(gpu=gpu, gate=gate, readiness=ready)
+        runtime = SimpleNamespace(idle_keepalive_enabled=True, idle_tick=lambda: calls.append('tick'))
+        try:
+            await idle_keepalive_tick(components)
+            ready.mark_ready(SimpleNamespace())
+            await idle_keepalive_tick(components)
+            assert calls == []
+            ready.mark_ready(runtime)
+            lease = gate.try_acquire()
+            await idle_keepalive_tick(components)
+            assert calls == []
+            lease.release()
+            await idle_keepalive_tick(components)
+            assert calls == ['tick']
+            def fail():
+                raise RuntimeError('tick failed')
+            runtime.idle_tick = fail
+            try:
+                await idle_keepalive_tick(components)
+            except RuntimeError:
+                pass
+            else:
+                raise AssertionError('failure was hidden')
+            lease = gate.try_acquire()
+            assert lease is not None
+            lease.release()
+        finally:
+            gpu.shutdown()
+    asyncio.run(scenario())
