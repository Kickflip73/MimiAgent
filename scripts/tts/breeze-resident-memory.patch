+    def wired_limit_bytes(self, device: Mapping[str, int]) -> int | None:
+        if self.wired_limit_gb is None:
+            return None
+        value = self.wired_limit_gb
+        # Reserve at least half of physical RAM for macOS and other applications.
+        ceiling = min(device["max_recommended_working_set_size"], device["memory_size"] // 2)
+        if not math.isfinite(value) or value <= 0 or value * 1e9 > ceiling:
+            raise ValueError("BREEZE_MLX_WIRED_GB must be positive and within the system/half-RAM limit")
+        return int(value * 1e9)
