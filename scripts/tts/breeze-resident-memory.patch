+def test_wired_memory_is_opt_in_and_bounded():
+    device = {"memory_size": 24_000_000_000, "max_recommended_working_set_size": 18_000_000_000}
+    assert MlxSpeedOptions().wired_limit_bytes(device) is None
+    speed = MlxSpeedOptions.from_env({"BREEZE_MLX_WIRED_GB": "8"})
+    assert speed.wired_limit_bytes(device) == 8_000_000_000
+    assert speed.report()["wired_limit_gb"] == 8
+    for invalid in ["-1", "0", "nan", "inf", "13", "19"]:
+        with pytest.raises(ValueError, match="BREEZE_MLX_WIRED_GB"):
+            MlxSpeedOptions.from_env({"BREEZE_MLX_WIRED_GB": invalid}).wired_limit_bytes(device)
+    with pytest.raises(ValueError, match="BREEZE_MLX_WIRED_GB"):
+        speed.wired_limit_bytes({**device, "max_recommended_working_set_size": 7_000_000_000})
