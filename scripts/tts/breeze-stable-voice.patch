diff --git a/tests/test_stable_voice.py b/tests/test_stable_voice.py
new file mode 100644
--- /dev/null
+++ b/tests/test_stable_voice.py
@@ -0,0 +1,44 @@
+"""Mimi single-speaker HTTP extension: never redesign a speaker mid-stream."""
+
+import pytest
+import torch
+
+from breeze_infer.routes_health import Readiness
+from tests.fakes import RecordingEvents
+from tests.test_routes_speech import _build_components, _client_for, _fake_runtime
+
+
+@pytest.mark.parametrize("value", ["yes", "-1", "2"])
+def test_stable_voice_rejects_unknown_values(value: str) -> None:
+    readiness = Readiness()
+    components = _build_components(readiness)
+    readiness.mark_ready(_fake_runtime())
+    try:
+        response = _client_for(components).post(
+            "/v1/audio/speech", data={"text": "Hello.", "stable_voice": value}
+        )
+        assert response.status_code == 400
+    finally:
+        components.gpu.shutdown()
+
+
+def test_stable_voice_never_redesigns_when_the_first_piece_cannot_anchor() -> None:
+    readiness = Readiness()
+    events = RecordingEvents()
+    components = _build_components(readiness, split_chars=100, events=events)
+    # A constrained context cannot accommodate the first sample as a reference.
+    runtime = _fake_runtime(chunks=1, frames=[torch.full((16,), 5)])
+    readiness.mark_ready(runtime)
+    sentence = (
+        "This sentence is long enough on its own to go past the budget of a piece, "
+        "which is one hundred characters."
+    )
+    try:
+        _client_for(components).post(
+            "/v1/audio/speech", data={"text": " ".join([sentence] * 3), "stable_voice": "1"}
+        )
+        assert len(runtime.calls) == 1
+        assert any(name == "speech.failed" for name, _ in events.calls)
+        assert not any(name == "speech.completed" for name, _ in events.calls)
+    finally:
+        components.gpu.shutdown()
