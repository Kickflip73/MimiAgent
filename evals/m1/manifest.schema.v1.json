{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimiagent.local/evals/m1/manifest.schema.v1.json",
  "title": "MimiAgent M1 Eval Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetRevision", "policyRevision", "toolSnapshotRevision", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetRevision": { "$ref": "#/$defs/revision" },
    "policyRevision": { "$ref": "#/$defs/revision" },
    "toolSnapshotRevision": { "$ref": "#/$defs/revision" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$" },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "app", "channel", "actionFamily", "executionPath", "risk", "boundaryRef", "expectedOutcome", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "app": { "type": "string", "minLength": 1, "maxLength": 80 },
        "channel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "actionFamily": { "$ref": "#/$defs/identifier" },
        "executionPath": { "$ref": "#/$defs/identifier" },
        "risk": { "enum": ["read", "draft", "low_write", "high_write"] },
        "boundaryRef": { "type": "string", "minLength": 1, "maxLength": 240 },
        "expectedOutcome": { "enum": ["success", "partial", "blocked", "failed", "uncertain"] },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
